# Gemini: either a Google AI Studio key...
GEMINI_API_KEY=
# ...or Vertex AI with your gcloud credentials (gcloud auth application-default login), no key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# Optional: model id (default gemini-3.8-flash)
CLAUSEPAY_MODEL=
# PayPal REST app credentials from developer.paypal.com (Sandbox tab)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional: the invoicer email shown on invoices (your sandbox business account)
PAYPAL_INVOICER_EMAIL=
# Optional: the ID of the PayPal webhook pointing at /api/paypal/webhook (payments then arrive by themselves)
PAYPAL_WEBHOOK_ID=
# Optional: the billing agent's thinking level (low, medium, high); unset = the model's own
CLAUSEPAY_AGENT_THINKING=
